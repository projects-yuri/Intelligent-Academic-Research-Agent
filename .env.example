# Escolha: openai ou openrouter
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=COLOQUE_SUA_CHAVE_AQUI

# Ative o tracing do LangSmith (obrigatório no trabalho)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=COLOQUE_SUA_CHAVE_LANGSMITH_AQUI
LANGSMITH_PROJECT=moss-scholar-react

# Opcional: amplia a pesquisa além dos 10 artigos locais
# OPENALEX_API_KEY=COLOQUE_SUA_CHAVE_OPENALEX_AQUI

# Para OpenRouter, altere as duas primeiras linhas por:
# LLM_PROVIDER=openrouter
# LLM_MODEL=openai/gpt-4o-mini
